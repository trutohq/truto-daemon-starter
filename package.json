{
  "name": "truto-daemon",
  "scripts": {
    "dev": "bun run src/index.ts | pino-pretty",
    "build": "bun build src/index.ts --outfile truto-daemon-darwin-arm64 --compile --minify --sourcemap --bytecode --target=bun-darwin-arm64",
    "build-linux": "bun build src/index.ts --outfile truto-daemon-linux-x64 --compile --minify --sourcemap --bytecode --target=bun-linux-x64"
  },
  "type": "module",
  "dependencies": {
    "@truto/truto-daemon": "0.0.4",
    "@truto/truto-ts-sdk": "1.0.21",
    "kysely": "0.24.2",
    "kysely-bun-sqlite": "0.3.2",
    "lodash-es": "4.17.21",
    "luxon": "3.5.0",
    "pino-pretty": "13.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/is-uuid": "1.0.0",
    "@types/change-case": "2.3.1",
    "@types/lodash-es": "4.17.12",
    "@types/qs": "6.9.16",
    "@typescript-eslint/eslint-plugin": "5.59.0",
    "@typescript-eslint/parser": "5.59.0",
    "eslint": "8.39.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.8.7",
    "typescript": "4.9.5"
  },
  "volta": {
    "node": "20.16.0",
    "yarn": "1.22.19"
  }
}
